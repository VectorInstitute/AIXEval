# Judge runner: which provider + model to use. Copy to .env (gitignored)
# and fill in real values. Unset vars fall back to the defaults noted below.

# anthropic | openai | gemini | vllm. Default: anthropic.
JUDGE_PROVIDER=anthropic

# Only the selected provider's key is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# vllm: your own self-hosted vLLM server. Needed only if that server was
# started with --api-key; vLLM's default has no auth.
VLLM_API_KEY=

# Each provider keeps its own model choice, so switching JUDGE_PROVIDER
# does not lose the others' settings.
JUDGE_MODEL_ANTHROPIC=claude-sonnet-5
JUDGE_MODEL_OPENAI=gpt-5.5
JUDGE_MODEL_GEMINI=gemini-flash-latest
# vllm has no default model: it must name whatever your server is serving.
JUDGE_MODEL_VLLM=
# vllm: where your server is running. Default if unset: http://localhost:8000/v1
VLLM_BASE_URL=
